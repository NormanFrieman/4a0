{
  "name": "quatro-a-zero",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "engine:play": "tsx tools/engine/cli/play.ts",
    "engine:validate": "tsx tools/engine/cli/validate.ts",
    "engine:bench": "tsx tools/engine/cli/bench.ts",
    "engine:ladder": "tsx tools/engine/cli/ladder.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "maia3-js": "0.2.0",
    "onnxruntime-web": "1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.31.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "esbuild"
    ]
  }
}
